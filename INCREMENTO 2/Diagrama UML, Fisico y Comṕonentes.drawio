  <diagram id="NRv5q2_OkHg1aNIb5sLS" name="Página-4">
    <mxGraphModel grid="1" page="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" pageScale="1" pageWidth="827" pageHeight="1169" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml\nskinparam classAttributeIconSize 0\ntitle Diagrama de Componentes – Incremento 2\n\nclass \&quot;PC usuario\&quot; as PC {\n  &lt;&lt;Requerimiento&gt;&gt;\n  - Conectividad de red: boolean\n  - Navegador compatible: boolean\n  ==&lt;&lt;Ejecutable&gt;&gt;==\n  + Navegador(): void\n  + RenderizarAppReact(): void\n  + EnviarSolicitudesApi(): void\n  + DragAndDropUploader(): void\n  + IdleTimer(): void\n}\n\nclass \&quot;Servidor web\&quot; as BE {\n  &lt;&lt;Requerimiento&gt;&gt;\n  - Conectividad a DB/Storage/SMTP/Jobs: boolean\n  - Autenticación JWT habilitada: boolean\n  ==&lt;&lt;Ejecutable&gt;&gt;==\n  + FlaskApp(): void\n  + C_api (API Gateway): void\n  + AuthSvc (C_auth, C_auth_Login, C_auth_bp): void\n  + DocsSvc (C_docs, C_docs_bp, C_docs_af): void\n  + StatsSvc (C_stats): void\n  + SurveySvc (satisfacción/auditoría): void\n  + TagService / BulkTagService: void\n  + FavoriteService: void\n  + CommentService / InternalReviewService: void\n  + LinkService (links seguros): void\n  + ArchiveService / TrashService: void\n  + DuplicateDetector: void\n  + SortService / PriorityService: void\n  + EvidenceService (evidencias): void\n  + ExportService (CSV/XLSX): void\n  + MailService: void\n  + SQLAlchemyORM(): void\n  + GenerarToken(JWT): void\n  + ReverseProxyNginx(): void\n}\n\nclass \&quot;Worker / Jobs\&quot; as JOBS {\n  &lt;&lt;Requerimiento&gt;&gt;\n  - Acceso a cola/cron: boolean\n  - Conectividad a DB/SMTP/Storage: boolean\n  ==&lt;&lt;Ejecutable&gt;&gt;==\n  + JobScheduler(): void\n  + TimerService(): void\n  + InactivityWorker (usuarios inactivos): void\n  + EmailNotifier (notificaciones): void\n  + VirusScanner / FormatValidator: void\n  + LimpiezaPapelera(): void\n  + GeneracionReportesBatch(): void\n}\n\nclass \&quot;Base de datos\&quot; as DB {\n  &lt;&lt;Requerimiento&gt;&gt;\n  - Conectividad de red: boolean\n  - Política de backups: boolean\n  ==&lt;&lt;Ejecutable&gt;&gt;==\n  + PostgreSQL(): void\n  + PersistenciaORM(): void\n  + MigracionesAlembic(): void\n  + Esquemas(usuarios, documentos, etiquetas, favoritos, comentarios,\n             enlaces, estados, auditorías, accesos, etc.): void\n}\n\nclass \&quot;Almacenamiento de Archivos y Evidencias\&quot; as FS {\n  &lt;&lt;Requerimiento&gt;&gt;\n  - Acceso local o remoto (S3/NAS): boolean\n  ==&lt;&lt;Ejecutable&gt;&gt;==\n  + GuardarArchivo(): void\n  + LeerArchivo(): void\n  + SubirAS3(): void\n  + AsociarEvidencia(): void\n}\n\nclass \&quot;Proveedor de Correo (SMTP)\&quot; as SMTP {\n  &lt;&lt;Requerimiento&gt;&gt;\n  - Credenciales y TLS: boolean\n  ==&lt;&lt;Ejecutable&gt;&gt;==\n  + EnviarCorreo(): void\n  + PlantillaNotificacion(): void\n}\n\nclass \&quot;Export/BI (Excel / Power BI)\&quot; as BI {\n  &lt;&lt;Requerimiento&gt;&gt;\n  - Conectividad externa: boolean\n  ==&lt;&lt;Ejecutable&gt;&gt;==\n  + ExportarCSV(): void\n  + ExportarXLSX(): void\n  + PublicarDataset(): void\n}\n\n&#39; Conexiones\nPC --&gt; BE : JSON vía HTTPS\nBE --&gt; DB : Conexión PostgreSQL\nBE --&gt; FS : S3/NFS\nBE --&gt; SMTP : SMTP/TLS\nBE --&gt; JOBS : Cola/Cron\nJOBS --&gt; DB\nJOBS --&gt; SMTP\nJOBS --&gt; FS\nBE --&gt; BI : .csv/.xlsx\n\nnote bottom of FS\n  Local / AWS S3\nend note\n\n@enduml\n&quot;,&#xa;  &quot;format&quot;: &quot;svg&quot;&#xa;}" id="OJZfeOFqQuexwU-Ww7TR-1">
          <mxCell style="shape=image;noLabel=1;verticalAlign=top;aspect=fixed;imageAspect=0;image=data:image/svg+xml,;" vertex="1" parent="1">
            <mxGeometry x="360" y="-486.57" width="1545" height="1627.57" as="geometry" />
          </mxCell>
        </UserObject>
      </root>
    </mxGraphModel>
  </diagram>
