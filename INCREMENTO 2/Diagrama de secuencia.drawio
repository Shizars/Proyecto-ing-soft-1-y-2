        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml\ntitle CU 44 – Subiendo evidencias complementarias\nactor Cliente as C\nboundary \&quot;V_Documento\&quot; as VDoc\ncontrol \&quot;C_evidence_bp (Negocio)\&quot; as C_evidence_bp\ncontrol \&quot;C_api (Gateway)\&quot; as API\ncontrol \&quot;C_evidence (Backend)\&quot; as C_evidence\ndatabase \&quot;PostgreSQL\&quot; as DB\ncollections \&quot;EStore (Evidencias)\&quot; as EStore\n\nC -&gt; VDoc: abrirEvidencias(docId)\nC -&gt; VDoc: adjuntarEvidencia(file, tipo)\nVDoc -&gt; C_evidence_bp: validarYSubir(docId, file, tipo)\nC_evidence_bp -&gt; API: POST /api/docs/{id}/evidences\nAPI -&gt; C_evidence: subir(docId, userId, file, tipo)\nC_evidence -&gt; EStore: guardar(file)\nEStore --&gt; C_evidence: ok\nC_evidence -&gt; DB: INSERT evidencia(docId, ruta, tipo)\nDB --&gt; C_evidence: ok\nC_evidence --&gt; API: ok\nAPI --&gt; C_evidence_bp: ok\nC_evidence_bp --&gt; VDoc: mostrarEvidenciaNueva()\n@enduml&quot;,&#xa;  &quot;format&quot;: &quot;svg&quot;&#xa;}" id="xNn_TTBp03rq3ZU4zBU1-1">
