        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml\ntitle CU 51 – Soporte para enlaces externos\nactor Cliente as C\nboundary \&quot;V_Documento\&quot; as VDoc\ncontrol \&quot;C_links_bp (Negocio)\&quot; as C_links_bp\ncontrol \&quot;C_api (Gateway)\&quot; as API\ncontrol \&quot;C_external_link (Backend)\&quot; as C_external_link\ndatabase \&quot;PostgreSQL\&quot; as DB\n\nC -&gt; VDoc: agregarEnlaceExterno(docId, url, descripcion)\nVDoc -&gt; C_links_bp: guardarEnlace(docId, url, descripcion)\nC_links_bp -&gt; API: POST /api/docs/{id}/external-links\nAPI -&gt; C_external_link: crear(docId, url, descripcion, userId)\nC_external_link -&gt; DB: INSERT external_link(docId, url, descripcion)\nDB --&gt; C_external_link: ok\nC_external_link --&gt; API: ok\nAPI --&gt; C_links_bp: ok\nC_links_bp --&gt; VDoc: mostrarEnlace(url)\n\nC -&gt; VDoc: abrirEnlaceExterno(linkId)\nVDoc -&gt; C_links_bp: resolver(linkId)\nC_links_bp -&gt; API: GET /api/docs/external-links/{id}\nAPI -&gt; C_external_link: obtener(linkId)\nC_external_link -&gt; DB: SELECT link\nDB --&gt; C_external_link: link\nC_external_link --&gt; API: link\nAPI --&gt; C_links_bp: link\nC_links_bp --&gt; VDoc: redirigir(url)\n@enduml&quot;,&#xa;  &quot;format&quot;: &quot;svg&quot;&#xa;}" id="6YJ0S1KTYV65NmYyzSCG-1">
