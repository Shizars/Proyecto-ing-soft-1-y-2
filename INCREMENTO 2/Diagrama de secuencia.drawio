        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml\ntitle CU 45 – Gestión de usuarios inactivos\nactor Administrador as A\ncontrol \&quot;C_inactive_job (Scheduler)\&quot; as C_inactive_job\nboundary \&quot;V_AdminUsuarios\&quot; as VAdmin\ncontrol \&quot;C_users_bp (Negocio)\&quot; as C_users_bp\ncontrol \&quot;C_api (Gateway)\&quot; as API\ncontrol \&quot;C_users (Backend)\&quot; as C_users\ncontrol \&quot;C_notification (Backend)\&quot; as C_notification\ndatabase \&quot;PostgreSQL\&quot; as DB\ncontrol \&quot;EmailService\&quot; as EmailService\n\n== Ejecución programada ==\nC_inactive_job -&gt; C_users: detectarInactivos(umbralDias)\nC_users -&gt; DB: SELECT usuarios WHERE last_login &lt; now()-umbral\nDB --&gt; C_users: lista\nC_users -&gt; C_notification: generarAvisos(lista)\nC_notification -&gt; EmailService: enviarRecordatorio(cada usuario)\nEmailService --&gt; C_notification: ok\n\n== Interacción de administración ==\nA -&gt; VAdmin: abrirInactivos()\nVAdmin -&gt; C_users_bp: listarInactivos()\nC_users_bp -&gt; API: GET /api/users/inactivos\nAPI -&gt; C_users: listarInactivos()\nC_users -&gt; DB: SELECT usuarios inactivos\nDB --&gt; C_users: lista\nC_users --&gt; API: lista\nAPI --&gt; C_users_bp: lista\nC_users_bp --&gt; VAdmin: mostrar(lista)\n\nA -&gt; VAdmin: desactivarUsuario(userId)\nVAdmin -&gt; C_users_bp: desactivar(userId)\nC_users_bp -&gt; API: POST /api/users/{id}/deactivate\nAPI -&gt; C_users: desactivar(userId)\nC_users -&gt; DB: UPDATE users SET activo=false\nDB --&gt; C_users: ok\nC_users --&gt; API: ok\nAPI --&gt; C_users_bp: ok\nC_users_bp --&gt; VAdmin: confirmar()\n@enduml&quot;,&#xa;  &quot;format&quot;: &quot;svg&quot;&#xa;}" id="7J2G95TBUCTKlNbAmAyk-1">
          <mxCell style="shape=image;noLabel=1;verticalAlign=top;aspect=fixed;imageAspect=0;image=data:image/svg+xml,;" vertex="1" parent="1">
            <mxGeometry x="1750" y="70" width="1352" height="969" as="geometry" />
          </mxCell>
        </UserObject>
