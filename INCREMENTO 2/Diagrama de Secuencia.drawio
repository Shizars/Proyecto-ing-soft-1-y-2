  <diagram id="_AqE9dhoE20fBcnzFb9w" name="Página-17">
    <mxGraphModel grid="1" page="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" pageScale="1" pageWidth="827" pageHeight="1169" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml\ntitle CU 21 – Cerrando sesión automáticamente\nactor Cliente as C\ncontrol \&quot;IdleTimer (Frontend)\&quot; as IdleFE\nboundary \&quot;V_Principal\&quot; as VMain\ncontrol \&quot;C_auth_bp (Negocio)\&quot; as BPAuth\ncontrol \&quot;C_api (Gateway)\&quot; as API\ncontrol \&quot;C_auth (Backend)\&quot; as AuthSvc\ndatabase \&quot;C_PostgreSql / Sesion\&quot; as DB\ncontrol \&quot;TimerService (Backend)\&quot; as Timer\n\nC -&gt; VMain: interacción\nVMain -&gt; IdleFE: resetTimer()\n\n== Falta de actividad ==\nIdleFE -&gt; VMain: advertirExpiracion(t-30s)\n...Usuario no interactúa...\nIdleFE -&gt; API: POST /api/auth/logout (motivo=timeout)\nAPI -&gt; AuthSvc: cerrarSesion(idSesion, timeout)\nAuthSvc -&gt; DB: UPDATE Sesion SET fueCerradaAutomatica=true, horaCierre=now()\nDB --&gt; AuthSvc: ok\nAuthSvc --&gt; API: ok\nAPI --&gt; IdleFE: ok\nIdleFE --&gt; VMain: redirigirLogin()\n\n== Expiración por horario (servidor) ==\nTimer -&gt; AuthSvc: cerrarSesionesPorHorario()\nAuthSvc -&gt; DB: UPDATE sesiones WHERE horarioFin &lt; now()\nDB --&gt; AuthSvc: ok\n@enduml\n&quot;,&#xa;  &quot;format&quot;: &quot;svg&quot;&#xa;}" id="PE-gPwjqlU0LeyiSGJqL-1">
          <mxCell style="shape=image;noLabel=1;verticalAlign=top;aspect=fixed;imageAspect=0;image=data:image/svg+xml,;" vertex="1" parent="1">
            <mxGeometry x="-330" y="50" width="1490" height="701" as="geometry" />
          </mxCell>
        </UserObject>
      </root>
    </mxGraphModel>
  </diagram>
