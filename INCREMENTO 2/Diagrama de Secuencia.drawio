        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml\nactor Usuario\nparticipant \&quot;C_docs (Backend)\&quot; as C_docs\ndatabase \&quot;PostgreSQL\&quot; as DB\n\nUsuario -&gt; C_docs : Solicita documento\nC_docs -&gt; DB : SELECT * FROM Documento WHERE id=...\nnote right of DB\n  Tabla usada: Documento\nend note\nDB --&gt; C_docs : Resultado (Documento)\nC_docs --&gt; Usuario : Devuelve información\n@enduml\n&quot;,&#xa;  &quot;format&quot;: &quot;svg&quot;&#xa;}" id="gYs4xmMfdFi2JQS6oPej-2">
          <mxCell style="shape=image;noLabel=1;verticalAlign=top;aspect=fixed;imageAspect=0;image=data:image/svg+xml,;" vertex="1" parent="1">
            <mxGeometry x="80" y="10" width="620" height="325" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml\nactor Usuario\nparticipant \&quot;C_docs (Backend)\&quot; as C_docs\ndatabase \&quot;PostgreSQL\&quot; as DB\nentity \&quot;Tabla Documento\&quot; as Documento\n\nUsuario -&gt; C_docs : Solicita documento\nC_docs -&gt; DB : Conexión a BD\nDB -&gt; Documento : SELECT * WHERE id=...\nDocumento --&gt; DB : Fila(s) encontradas\nDB --&gt; C_docs : Resultado consulta\nC_docs --&gt; Usuario : Devuelve información\n@enduml\n&quot;,&#xa;  &quot;format&quot;: &quot;svg&quot;&#xa;}" id="gYs4xmMfdFi2JQS6oPej-3">
          <mxCell style="shape=image;noLabel=1;verticalAlign=top;aspect=fixed;imageAspect=0;image=data:image/svg+xml,;" vertex="1" parent="1">
            <mxGeometry x="90" y="390" width="544" height="346" as="geometry" />
          </mxCell>
        </UserObject>
      </root>
    </mxGraphModel>
